  .gpr__avatar--mecca { background: linear-gradient(135deg, #2D2D4A, #1A1A2E); }

  .gpr__city-pill {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 5px 16px;
    border-radius: 20px;
