---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, getLocalePath } from '../../i18n/ui';
import { services } from '../../data/services';

const lang = getLangFromUrl(Astro.url);
const service = services.find(s => s.slug === 'planification')!;
---

<BaseLayout title={service.title} description={service.subtitle}>

<!-- Hero -->
<section class="sv-hero">
  <div class="sv-hero__bg">
    <img src={service.heroImage} alt="" loading="eager" />
  </div>
  <div class="sv-hero__overlay"></div>
  <a href={getLocalePath(lang, '/')} class="sv-hero__back" aria-label="Retour">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M13 4l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
  <div class="sv-hero__content">
    <p class="sv-hero__eyebrow load-rise" style="--load-delay: 100ms">{service.eyebrow}</p>
    <h1 class="sv-hero__title load-rise" style="--load-delay: 250ms">{service.title}</h1>
    <p class="sv-hero__sub load-rise" style="--load-delay: 400ms">{service.subtitle}</p>
  </div>
</section>

<!-- Intro -->
<section class="pl-intro">
  <div class="pl-container">
    <p class="pl-intro__eyebrow reveal">Conseil &amp; Optimisation</p>
    <h2 class="pl-intro__title reveal">Votre appel priv&eacute; avec un expert</h2>
    <div class="pl-intro__price reveal">
      <span class="pl-intro__price-amount">39&nbsp;&euro;</span>
      <span class="pl-intro__price-note">la session de 30 minutes</span>
    </div>
    <p class="pl-intro__text reveal">
      Vous partez en Omra de mani&egrave;re autonome ? Ne laissez pas de place au stress et &agrave; la
      perte de temps entre les &eacute;tapes de M&eacute;dine et de La Mecque.
    </p>
    <p class="pl-intro__text reveal">
      R&eacute;servez un entretien priv&eacute; de 30 minutes avec un expert pour structurer
      l'int&eacute;gralit&eacute; de votre s&eacute;jour, &eacute;viter les pi&egrave;ges logistiques
      et ma&icirc;triser votre budget.
    </p>

    <div class="pl-benefits reveal">
      <h3 class="pl-benefits__title">Ce que vous obtenez apr&egrave;s nos 30 minutes d'appel :</h3>
      <div class="pl-benefits__item">
        <span class="pl-benefits__emoji" aria-hidden="true">🚀</span>
        <p><strong>L'avis d'un expert :</strong> vos questions sp&eacute;cifiques r&eacute;pondues en direct.</p>
      </div>
      <div class="pl-benefits__item">
        <span class="pl-benefits__emoji" aria-hidden="true">⏱️</span>
        <p><strong>Z&eacute;ro temps perdu :</strong> un s&eacute;jour optimis&eacute; selon votre rythme et votre budget.</p>
      </div>
      <div class="pl-benefits__item">
        <span class="pl-benefits__emoji" aria-hidden="true">🗺️</span>
        <p><strong>Votre planning visuel :</strong> une feuille de route claire &agrave; suivre sur place.</p>
      </div>
      <div class="pl-benefits__item">
        <span class="pl-benefits__emoji" aria-hidden="true">💰</span>
        <p><strong>Astuces budget :</strong> comment g&eacute;rer les transports et la vie locale sans surpayer.</p>
      </div>
      <div class="pl-benefits__item">
        <span class="pl-benefits__emoji" aria-hidden="true">🎁</span>
        <p><strong>BONUS :</strong> le Guide PDF &laquo;&nbsp;L'Indispensable&nbsp;&raquo; (Avant / Pendant / Apr&egrave;s le d&eacute;part).</p>
      </div>
      <p class="pl-benefits__closing">Repartez l'esprit 100&nbsp;% tranquille avant de prendre l'avion.</p>
    </div>
  </div>
</section>

<!-- Formulaire -->
<section class="pl-form-section">
  <div class="pl-container">
    <form class="pl-form reveal" id="planif-form" novalidate>
      <h3 class="pl-form__title">Parlez-nous de votre voyage</h3>

      <div class="pl-form__field">
        <label for="pl-name">Nom &amp; Pr&eacute;nom</label>
        <input type="text" id="pl-name" name="name" required autocomplete="name" />
      </div>

      <div class="pl-form__row">
        <div class="pl-form__field">
          <label for="pl-group">Nombre de personnes</label>
          <input type="number" id="pl-group" name="groupSize" min="1" max="200" required />
        </div>
        <div class="pl-form__field">
          <label for="pl-phone">Num&eacute;ro de t&eacute;l&eacute;phone</label>
          <input type="tel" id="pl-phone" name="phone" required autocomplete="tel" />
        </div>
      </div>

      <div class="pl-form__row">
        <div class="pl-form__field">
          <label for="pl-arrival">Date d'arriv&eacute;e en Arabie Saoudite</label>
          <input type="date" id="pl-arrival" name="arrival" required />
        </div>
        <div class="pl-form__field">
          <label for="pl-departure">Date de d&eacute;part de l'Arabie Saoudite</label>
          <input type="date" id="pl-departure" name="departure" required />
        </div>
      </div>

      <div class="pl-form__field">
        <label for="pl-email">Email</label>
        <input type="email" id="pl-email" name="email" required autocomplete="email" />
      </div>

      <fieldset class="pl-form__field pl-form__tickets">
        <legend>J'ai d&eacute;j&agrave; mes billets d'avion :</legend>
        <div class="pl-form__radio-row">
          <label class="pl-form__radio">
            <input type="radio" name="hasTickets" value="oui" required />
            <span>Oui</span>
          </label>
          <label class="pl-form__radio">
            <input type="radio" name="hasTickets" value="non" required />
            <span>Non</span>
          </label>
        </div>
      </fieldset>

      <div class="pl-form__field pl-cal-field">
        <label>Je souhaite un appel le :</label>
        <button type="button" class="pl-cal-open" id="pl-cal-open" aria-expanded="false">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><rect x="3" y="4" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 8h14M7 2v3M13 2v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <span id="pl-cal-open-label">Choisir une date</span>
          <svg class="pl-cal-open__chev" width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="pl-cal-wrap is-hidden" id="pl-cal-wrap">
        <div class="pl-cal" id="pl-cal">
          <div class="pl-cal__head">
            <button type="button" class="pl-cal__nav" id="pl-cal-prev" aria-label="Mois pr&eacute;c&eacute;dent">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M13 4l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <span class="pl-cal__month" id="pl-cal-month">&mdash;</span>
            <button type="button" class="pl-cal__nav" id="pl-cal-next" aria-label="Mois suivant">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M7 4l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <div class="pl-cal__weekdays">
            <span>L</span><span>M</span><span>M</span><span>J</span><span>V</span><span>S</span><span>D</span>
          </div>
          <div class="pl-cal__grid" id="pl-cal-grid"></div>
          <p class="pl-cal__loading" id="pl-cal-loading">Chargement des disponibilit&eacute;s&hellip;</p>
          <p class="pl-cal__empty is-hidden" id="pl-cal-empty">Aucune disponibilit&eacute; pour le moment. Revenez bient&ocirc;t.</p>
        </div>
        <div class="pl-slots is-hidden" id="pl-slots">
          <p class="pl-slots__label">Cr&eacute;neaux disponibles le <strong id="pl-slots-date"></strong></p>
          <div class="pl-slots__list" id="pl-slots-list"></div>
        </div>
        </div>
        <input type="hidden" name="callDate" id="pl-call-date" />
        <input type="hidden" name="callTime" id="pl-call-time" />
      </div>

      <p class="pl-form__error is-hidden" id="planif-error">Merci de remplir tous les champs correctement.</p>

      <button type="submit" class="pl-form__submit">
        R&eacute;server mon appel et proc&eacute;der au paiement
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M4 10h12M12 5l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </form>

    <div class="pl-success is-hidden" id="planif-success">
      <div class="pl-success__icon">
        <svg viewBox="0 0 48 48" fill="none" width="48" height="48"><circle cx="24" cy="24" r="21" stroke="currentColor" stroke-width="2"/><path d="M15 24.5l6.5 6.5L33 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h3 class="pl-success__title">Demande envoy&eacute;e !</h3>
      <p class="pl-success__text">
        Merci d'avoir fait confiance &agrave; notre agence, notre &eacute;quipe prendra contact
        avec vous dans les prochaines 24&nbsp;heures&nbsp;!
      </p>
      <a href={getLocalePath(lang, '/')} class="pl-success__home">
        Retour &agrave; l'accueil
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M4 10h12M12 5l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>

</BaseLayout>

<script>
  import { supabase, SUPABASE_URL, SUPABASE_ANON_KEY } from '../../lib/supabase';

  const form = document.getElementById('planif-form') as HTMLFormElement | null;
  const errorMsg = document.getElementById('planif-error');

  // ---- Calendrier des créneaux d'appel ----
  const monthEl = document.getElementById('pl-cal-month');
  const gridEl = document.getElementById('pl-cal-grid');
  const loadingEl = document.getElementById('pl-cal-loading');
  const emptyEl = document.getElementById('pl-cal-empty');
  const prevBtn = document.getElementById('pl-cal-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('pl-cal-next') as HTMLButtonElement | null;
  const slotsWrap = document.getElementById('pl-slots');
  const slotsDateEl = document.getElementById('pl-slots-date');
  const slotsListEl = document.getElementById('pl-slots-list');
  const callDateInput = document.getElementById('pl-call-date') as HTMLInputElement | null;
  const callTimeInput = document.getElementById('pl-call-time') as HTMLInputElement | null;
  const calOpenBtn = document.getElementById('pl-cal-open');
  const calWrap = document.getElementById('pl-cal-wrap');
  const calOpenLabel = document.getElementById('pl-cal-open-label');

  const MONTHS_FR = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];

  calOpenBtn?.addEventListener('click', () => {
    const isOpen = !calWrap?.classList.contains('is-hidden');
    if (isOpen) {
      calWrap?.classList.add('is-hidden');
      calOpenBtn.setAttribute('aria-expanded', 'false');
      calOpenBtn.classList.remove('pl-cal-open--open');
    } else {
      calWrap?.classList.remove('is-hidden');
      calOpenBtn.setAttribute('aria-expanded', 'true');
      calOpenBtn.classList.add('pl-cal-open--open');
    }
  });

  function updateCalLabel() {
    if (!calOpenLabel) return;
    const dv = callDateInput?.value;
    const tv = callTimeInput?.value;
    if (dv && tv) {
      calOpenLabel.textContent = `${formatDateFr(dv)} · ${tv}`;
      calOpenBtn?.classList.add('pl-cal-open--filled');
    } else {
      calOpenLabel.textContent = 'Choisir une date';
      calOpenBtn?.classList.remove('pl-cal-open--filled');
    }
  }
  let freeSlots: Record<string, string[]> = {};
  let viewYear = 0;
  let viewMonth = 0;
  let selectedDate: string | null = null;

  function formatDateFr(dateStr: string): string {
    const [y, m, d] = dateStr.split('-').map(Number);
    return `${d} ${MONTHS_FR[m - 1].toLowerCase()} ${y}`;
  }

  async function loadSlots() {
    const { data, error } = await supabase
      .from('call_free_slots')
      .select('date, time')
      .order('date', { ascending: true })
      .order('time', { ascending: true });

    loadingEl?.classList.add('is-hidden');
    if (error || !data || data.length === 0) {
      emptyEl?.classList.remove('is-hidden');
      return;
    }
    freeSlots = {};
    data.forEach((r: any) => {
      (freeSlots[r.date] = freeSlots[r.date] || []).push(r.time);
    });
    const [y, m] = data[0].date.split('-').map(Number);
    viewYear = y;
    viewMonth = m - 1;
    renderCalendar();
  }

  function renderCalendar() {
    if (!gridEl || !monthEl) return;
    monthEl.textContent = `${MONTHS_FR[viewMonth]} ${viewYear}`;
    gridEl.innerHTML = '';
    const firstDow = (new Date(viewYear, viewMonth, 1).getDay() + 6) % 7;
    const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
    for (let i = 0; i < firstDow; i++) {
      const s = document.createElement('span');
      s.className = 'pl-cal__cell pl-cal__cell--empty';
      gridEl.appendChild(s);
    }
    for (let d = 1; d <= daysInMonth; d++) {
      const dateStr = `${viewYear}-${String(viewMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'pl-cal__cell';
      btn.textContent = String(d);
      const has = freeSlots[dateStr] && freeSlots[dateStr].length;
      if (has) {
        btn.classList.add('pl-cal__cell--avail');
        btn.addEventListener('click', () => selectDate(dateStr, btn));
      } else {
        btn.disabled = true;
        btn.classList.add('pl-cal__cell--off');
      }
      if (dateStr === selectedDate) btn.classList.add('pl-cal__cell--selected');
      gridEl.appendChild(btn);
    }
  }

  function selectDate(dateStr: string, btn: HTMLButtonElement) {
    selectedDate = dateStr;
    gridEl?.querySelectorAll('.pl-cal__cell--selected').forEach((c) => c.classList.remove('pl-cal__cell--selected'));
    btn.classList.add('pl-cal__cell--selected');
    if (callDateInput) callDateInput.value = dateStr;
    if (callTimeInput) callTimeInput.value = '';
    if (slotsDateEl) slotsDateEl.textContent = formatDateFr(dateStr);
    if (slotsListEl) {
      slotsListEl.innerHTML = '';
      (freeSlots[dateStr] || []).forEach((t) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'pl-slot';
        b.textContent = t;
        b.addEventListener('click', () => {
          slotsListEl.querySelectorAll('.pl-slot--active').forEach((x) => x.classList.remove('pl-slot--active'));
          b.classList.add('pl-slot--active');
          if (callTimeInput) callTimeInput.value = t;
          updateCalLabel();
        });
        slotsListEl.appendChild(b);
      });
    }
    slotsWrap?.classList.remove('is-hidden');
    updateCalLabel();
  }

  prevBtn?.addEventListener('click', () => {
    viewMonth--;
    if (viewMonth < 0) { viewMonth = 11; viewYear--; }
    renderCalendar();
  });
  nextBtn?.addEventListener('click', () => {
    viewMonth++;
    if (viewMonth > 11) { viewMonth = 0; viewYear++; }
    renderCalendar();
  });

  loadSlots();

  // ---- Soumission : réservation + paiement Stripe ----
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const date = callDateInput?.value || '';
      const time = callTimeInput?.value || '';

      if (!form.checkValidity()) {
        if (errorMsg) {
          errorMsg.textContent = 'Merci de remplir tous les champs correctement.';
          errorMsg.classList.remove('is-hidden');
        }
        return;
      }
      if (!date || !time) {
        if (errorMsg) {
          errorMsg.textContent = 'Merci de choisir une date et un créneau pour votre appel.';
          errorMsg.classList.remove('is-hidden');
        }
        document.getElementById('pl-cal')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      errorMsg?.classList.add('is-hidden');

      const submitBtn = form.querySelector('.pl-form__submit') as HTMLButtonElement;
      const originalHtml = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.classList.add('is-loading');
      submitBtn.innerHTML = 'Traitement<span class="pl-dots"><span>.</span><span>.</span><span>.</span></span>';

      const data = new FormData(form);
      const name = String(data.get('name') || '');
      const groupSize = parseInt(String(data.get('groupSize'))) || null;
      const arrival = String(data.get('arrival') || '') || null;
      const departure = String(data.get('departure') || '') || null;
      const phone = String(data.get('phone') || '');
      const email = String(data.get('email') || '');
      const hasTickets = data.get('hasTickets') === 'oui';

      function fail(msg: string) {
        if (errorMsg) { errorMsg.textContent = msg; errorMsg.classList.remove('is-hidden'); }
        submitBtn.disabled = false;
        submitBtn.classList.remove('is-loading');
        submitBtn.innerHTML = originalHtml;
      }

      // 1) Créer la réservation d'appel (statut pending)
      const { data: rpc, error: rpcErr } = await supabase.rpc('create_call_booking', {
        p_date: date,
        p_time: time,
        p_name: name,
        p_group_size: groupSize,
        p_arrival: arrival,
        p_departure: departure,
        p_phone: phone,
        p_email: email,
        p_has_tickets: hasTickets,
      });

      if (rpcErr) {
        const m = rpcErr.message || '';
        if (m.includes('SLOT_ALREADY_BOOKED') || m.includes('SLOT_UNAVAILABLE')) {
          selectedDate = null;
          if (callDateInput) callDateInput.value = '';
          if (callTimeInput) callTimeInput.value = '';
          slotsWrap?.classList.add('is-hidden');
          emptyEl?.classList.add('is-hidden');
          await loadSlots();
          fail('Ce créneau vient d\'être réservé. Merci d\'en choisir un autre.');
        } else {
          fail("Une erreur est survenue. Veuillez réessayer.");
        }
        return;
      }

      const bookingId = (rpc as any)?.id;

      // 2) Créer la session de paiement Stripe et rediriger
      try {
        const res = await fetch(`${SUPABASE_URL}/functions/v1/create-checkout`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
            'apikey': SUPABASE_ANON_KEY,
          },
          body: JSON.stringify({
            callBooking: {
              id: bookingId,
              date, time, name, groupSize, arrival, departure, phone, email, hasTickets,
              price: 39,
            },
            successUrl: `${window.location.origin}/paiement/confirmation/?type=call&session_id={CHECKOUT_SESSION_ID}`,
            cancelUrl: `${window.location.origin}/services/planification/`,
          }),
        });
        const cdata = await res.json();
        if (cdata.url) {
          window.location.href = cdata.url;
        } else {
          fail(cdata.error || "Impossible de démarrer le paiement. Veuillez réessayer.");
        }
      } catch {
        fail("Impossible de démarrer le paiement. Veuillez réessayer.");
      }
    });
  }
</script>

<style is:global>
  .is-hidden { display: none !important; }

  .pl-container { max-width: 680px; margin: 0 auto; padding: 0 24px; }

  /* ---- HERO (réutilise les styles sv-hero) ---- */
  .sv-hero {
    position: relative;
    overflow: hidden;
    min-height: 420px;
    display: flex;
    align-items: flex-end;
  }
  .sv-hero__bg { position: absolute; inset: 0; }
  .sv-hero__bg img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 60%;
  }
  .sv-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(12,58,40,0.12) 0%, rgba(12,58,40,0.45) 60%, rgba(12,58,40,0.72) 100%);
  }
  .sv-hero__content {
    position: relative; z-index: 2;
    max-width: 800px; margin: 0 auto;
    padding: 120px 24px 60px; width: 100%;
  }
  .sv-hero__back {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 50%;
    background: rgba(0,0,0,0.45);
    backdrop-filter: blur(8px);
    color: #FFFFFF;
    position: absolute; top: 16px; left: 24px;
    z-index: 3;
    transition: background 0.2s;
    text-decoration: none;
  }
  .sv-hero__back:hover { background: rgba(0,0,0,0.6); color: #FFFFFF; }
  .sv-hero__eyebrow {
    font-family: 'Jost', sans-serif;
    font-size: 0.7rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.26em;
    color: #CBA96A; margin-bottom: 12px;
  }
  .sv-hero__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 3.2rem; font-weight: 700;
    color: #FAF8F4; line-height: 1.05; letter-spacing: -0.01em;
    margin-bottom: 16px; text-transform: uppercase;
  }
  .sv-hero__sub {
    font-family: 'Jost', sans-serif;
    font-size: 0.95rem; font-weight: 300;
    color: rgba(250,248,244,0.78); line-height: 1.7;
    max-width: 480px;
  }

  /* ---- INTRO ---- */
  .pl-intro {
    background: #FFFFFF;
    padding: 56px 0 8px;
  }
  .pl-intro__eyebrow {
    font-family: 'Jost', sans-serif;
    font-size: 0.7rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.22em;
    color: #B99752; margin: 0 0 8px;
  }
  .pl-intro__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.9rem; font-weight: 700;
    color: #14513A; line-height: 1.15;
    margin: 0 0 20px;
  }
  .pl-intro__text {
    font-family: 'Jost', sans-serif;
    font-size: 0.95rem; font-weight: 300;
    color: #4A4A42; line-height: 1.8;
    margin: 0 0 16px;
  }

  /* ---- TARIF ---- */
  .pl-intro__price {
    display: inline-flex; align-items: baseline; gap: 10px;
    background: #FAF8F4;
    border: 1px solid #EFEDE6;
    border-radius: 14px;
    padding: 12px 22px;
    margin: 0 0 22px;
  }
  .pl-intro__price-amount {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 2rem; font-weight: 700; color: #14513A;
    line-height: 1;
  }
  .pl-intro__price-note {
    font-family: 'Jost', sans-serif;
    font-size: 0.82rem; font-weight: 400; color: #6B6B63;
  }

  /* ---- BÉNÉFICES ---- */
  .pl-benefits {
    background: #FAF8F4;
