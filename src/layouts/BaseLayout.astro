---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { getLangFromUrl, getLocalePath, t } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  cityTheme?: 'medina' | 'mecca';
  hasHero?: boolean;
  preloadImage?: string;
  /** Visuel préchargé à partir de 1024px (quand le bureau a sa propre image) */
  preloadImageDesktop?: string;
  noindex?: boolean;
}

const { title, description, cityTheme, hasHero, preloadImage, preloadImageDesktop, noindex } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const siteName = t(lang, 'site.name');
const fullTitle = `${title} | ${siteName}`;
const metaDescription = description ?? t(lang, 'hero.subtitle');
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={Astro.url} />
    <!-- Google exige un favicon CARRÉ dont la taille est un multiple de 48 px,
         sinon il n'affiche aucun logo dans ses résultats de recherche. -->
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Jost:wght@300;400;500;600&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {preloadImage && (
      preloadImageDesktop
        ? <link rel="preload" as="image" href={preloadImage} media="(max-width: 1023px)" fetchpriority="high" />
        : <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    {preloadImageDesktop && <link rel="preload" as="image" href={preloadImageDesktop} media="(min-width: 1024px)" fetchpriority="high" />}
  </head>
  <body class:list={[cityTheme && `city-${cityTheme}`, hasHero && 'has-hero']}>
    <Header transparent={hasHero} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <!-- WhatsApp button -->
    <a
      href="https://wa.me/33671796772?text=As-salamu%20alaykum%2C%20je%20souhaite%20avoir%20des%20informations%20sur%20vos%20services."
      target="_blank"
      rel="noopener noreferrer"
      class="whatsapp-btn"
      aria-label="Nous contacter sur WhatsApp"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
      </svg>
    </a>

    <!-- Scroll to top button -->
    <button class="scroll-top" id="scroll-top-btn" aria-label="Retour en haut de la page">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <!-- Bannière consentement cookies -->
    <div class="cookie-consent" id="cookie-consent" hidden>
      <div class="cookie-consent__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
          <circle cx="8.5" cy="10.5" r=".6" fill="currentColor"/>
          <circle cx="11" cy="15" r=".6" fill="currentColor"/>
          <circle cx="15" cy="13" r=".6" fill="currentColor"/>
        </svg>
      </div>
      <div class="cookie-consent__body">
        <p class="cookie-consent__text">
          Nous utilisons des cookies pour am&eacute;liorer votre exp&eacute;rience et mesurer l'audience du site.
          <a href={getLocalePath(lang, '/mentions-legales/')}>En savoir plus</a>
        </p>
        <div class="cookie-consent__actions">
          <button type="button" class="cookie-consent__btn cookie-consent__btn--refuse" id="cookie-refuse">Refuser</button>
          <button type="button" class="cookie-consent__btn cookie-consent__btn--accept" id="cookie-accept">Accepter</button>
        </div>
      </div>
    </div>

    <style is:global>
      /* WhatsApp button */
      .whatsapp-btn {
        position: fixed;
        bottom: 24px;
        right: 24px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #25D366;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 999;
        box-shadow: 0 4px 20px rgba(37, 211, 102, 0.35);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s;
        text-decoration: none;
      }

      .whatsapp-btn:hover {
        transform: scale(1.08);
        box-shadow: 0 6px 28px rgba(37, 211, 102, 0.5);
        color: white;
      }

      .whatsapp-btn__pulse {
        position: absolute;
        width: 68px;
        height: 68px;
        border-radius: 50%;
        border: 2px solid rgba(37, 211, 102, 0.4);
        animation: waPulse 2s ease-out infinite;
        pointer-events: none;
      }

      @keyframes waPulse {
        0% { transform: scale(0.9); opacity: 1; }
        100% { transform: scale(1.4); opacity: 0; }
      }

      /* Scroll to top */
      .scroll-top {
        position: fixed;
        bottom: 96px;
        right: 24px;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #1A1A1A;
        color: white;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 998;
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px);
        transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                    transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                    background 0.3s;
        box-shadow: 0 4px 20px rgba(0, 40, 20, 0.08);
      }

      .scroll-top.is-visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      .scroll-top:hover {
        background: var(--color-primary, #14513A);
      }

      /* Consentement cookies */
      .cookie-consent {
        position: fixed;
        bottom: 24px;
        left: 24px;
        z-index: 1000;
        display: flex;
        align-items: flex-start;
        gap: 14px;
        max-width: 360px;
        padding: 18px 20px;
        background: #FFFFFF;
        border: 1px solid #ECE7DA;
        border-radius: 16px;
        box-shadow: 0 16px 44px rgba(8, 40, 24, 0.16);
        animation: cookieRise 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
      }
      .cookie-consent[hidden] { display: none; }
      .cookie-consent__icon {
        flex-shrink: 0;
        width: 40px; height: 40px;
        border-radius: 50%;
        background: #EDF5F0;
        color: #14513A;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .cookie-consent__text {
        font-family: 'Jost', sans-serif;
        font-size: 0.8rem;
        font-weight: 300;
        line-height: 1.5;
        color: #4A4A42;
        margin: 0 0 12px;
      }
      .cookie-consent__text a {
        color: #14513A;
        font-weight: 500;
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .cookie-consent__text a:hover { color: #B99752; }
      .cookie-consent__actions {
        display: flex;
        gap: 8px;
      }
      .cookie-consent__btn {
        flex: 1;
        padding: 9px 14px;
        border-radius: 8px;
        font-family: 'Jost', sans-serif;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
      }
      .cookie-consent__btn--refuse {
        background: none;
        border: 1px solid #DAD5C7;
        color: #6B6B63;
      }
      .cookie-consent__btn--refuse:hover {
        border-color: #B7B1A0;
        color: #1C1C1A;
      }
      .cookie-consent__btn--accept {
        background: linear-gradient(135deg, #14513A, #0C3A28);
        border: 1px solid transparent;
        color: #FAF8F4;
      }
      .cookie-consent__btn--accept:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(20, 81, 58, 0.28);
      }
      @keyframes cookieRise {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @media (max-width: 639px) {
        .cookie-consent {
          left: 12px; right: 12px; bottom: 12px;
          max-width: none;
          padding: 16px;
        }
      }
    </style>

    <script>
      const scrollBtn = document.getElementById('scroll-top-btn');
      if (scrollBtn) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 400) {
            scrollBtn.classList.add('is-visible');
          } else {
            scrollBtn.classList.remove('is-visible');
          }
        }, { passive: true });

        scrollBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // Consentement cookies
      const cookieBanner = document.getElementById('cookie-consent');
      if (cookieBanner) {
        const choice = localStorage.getItem('omra-cookie-consent');
        if (!choice) {
          // léger délai pour laisser la page s'afficher d'abord
          setTimeout(() => { cookieBanner.hidden = false; }, 800);
        }
        const close = (value: string) => {
          localStorage.setItem('omra-cookie-consent', value);
          cookieBanner.style.animation = 'cookieRise 0.35s cubic-bezier(0.16,1,0.3,1) reverse forwards';
          setTimeout(() => { cookieBanner.hidden = true; }, 340);
        };
        document.getElementById('cookie-accept')?.addEventListener('click', () => close('accepted'));
        document.getElementById('cookie-refuse')?.addEventListener('click', () => close('refused'));
      }

      // Scroll reveal observer
      const revealEls = document.querySelectorAll('.reveal, .reveal-scale, .reveal-blur, .reveal-line, .reveal-img');
      if (revealEls.length > 0) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        revealEls.forEach(el => observer.observe(el));
      }
    </script>
  </body>
</html>
